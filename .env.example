# Copie para .env e ajuste

TZ=America/Rio_Branco
CROWDSEC_TAG=latest

# Pasta de logs do Nginx Proxy Manager NO HOST.
# No stack do guam-remote-desktop ela fica em ./data/npm/data/logs.
NPM_LOGS=/opt/guam-remote-desktop/data/npm/data/logs

# Porta da API local (LAPI), publicada só em 127.0.0.1
LAPI_PORT=8080
